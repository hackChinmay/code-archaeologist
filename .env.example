# ==============================================================================
# Code Archaeologist / RepoMind - Environment Configuration Template
# Copy this file to .env locally or configure these variables in Render / Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Render Web Service / Local FastAPI)
# ------------------------------------------------------------------------------

# Google Gemini API Key (Required for LangChain RAG & generative answers)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port and Host (Render automatically assigns PORT in production)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated URLs of your deployed frontend)
# Example: https://code-archaeologist.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Relational Database Connection String
# Defaults to local SQLite if omitted.
# PostgreSQL (Render Free PG, Neon, Supabase): postgresql://user:pass@host:5432/dbname
# MySQL: mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=sqlite:///./code_archaeologist.db

# ChromaDB Vector Store Configuration
# Defaults to local directory persistence (./chroma_data).
# For remote ChromaDB (e.g. hosted Chroma or separate instance):
# CHROMA_HOST=your-chroma-host.onrender.com
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_AUTH_TOKEN=your_token_if_auth_enabled
CHROMA_PERSIST_DIR=./chroma_data

# GitHub Personal Access Token (Optional)
# Increases GitHub REST API rate limits from 60 req/hr to 5,000 req/hr
# and allows analyzing private repositories.
GITHUB_TOKEN=

# Memory Safety Limits (Configured for Render Free 512MB RAM)
# MAX_REPO_FILES: Maximum source files to ingest per repository (default: 60)
MAX_REPO_FILES=60
# MAX_FILE_SIZE_BYTES: Maximum allowed file size in bytes (default: 262144 / 256KB)
MAX_FILE_SIZE_BYTES=262144
# MAX_REPO_TOTAL_SIZE_BYTES: Maximum total repository size in bytes (default: 10485760 / 10MB)
MAX_REPO_TOTAL_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel Project Settings / Local Vite)
# ------------------------------------------------------------------------------

# Base URL pointing to the deployed backend FastAPI service on Render
# In local development, leave empty to use the built-in Vite dev proxy.
# On Vercel: set to your Render service URL (e.g., https://code-archaeologist-backend.onrender.com)
VITE_API_BASE_URL=